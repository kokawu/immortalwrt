# Minimal seed.config for ImmortalWrt x86_64 VM, IPv6, PPPoE/DHCP/Static, no WiFi
# How to use: cp seed.config .config && make defconfig

# Target platform
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# Version information with build date
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_NUMBER=""
CONFIG_VERSION_CODE=""
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org"

# Image formats and sizes
CONFIG_EFI_IMAGES=y
CONFIG_QCOW2_IMAGES=y
CONFIG_VMDK_IMAGES=n
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n

# Build accelerations / global
CONFIG_CCACHE=y
# Avoid enabling SDK/ImageBuilder/Toolchain here to reduce build time/size

# Networking - WAN types
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# IPv6
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# Firewall/nft offload (optional but useful on x86)
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-offload=y

# VM/virt and NIC drivers
CONFIG_PACKAGE_kmod-virtio=y
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-virtio-scsi=y
CONFIG_PACKAGE_kmod-balloon=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8152=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-hv-netvsc=y

  # 通用物理机网卡驱动集（Intel/Realtek/Broadcom/Aquantia/Marvell/Mellanox + USB-NIC）
  # Intel 1G/2.5G/10G/25G
  CONFIG_PACKAGE_kmod-ice=y      # Intel E810 (ice)
  # Broadcom 千兆/万兆
  CONFIG_PACKAGE_kmod-tg3=y
  CONFIG_PACKAGE_kmod-bnx2=y
  CONFIG_PACKAGE_kmod-bnx2x=y
  # Aquantia/Marvell 2.5G/5G/10G
  CONFIG_PACKAGE_kmod-atlantic=y
  # Mellanox 万兆/25G
  CONFIG_PACKAGE_kmod-mlx5-core=y
  # 常见 USB 网卡基础与常用芯片
  CONFIG_PACKAGE_kmod-usb-net=y
  CONFIG_PACKAGE_kmod-usb-net-ax8817x=y
  CONFIG_PACKAGE_kmod-usb-net-ax88179_178a=y
  CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y

# Disable WiFi stack/drivers/firmware (no wireless needed)
CONFIG_PACKAGE_wpad=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_kmod-mt7915e=n
CONFIG_PACKAGE_kmod-mt7921e=n
CONFIG_PACKAGE_kmod-mt7925e=n
CONFIG_PACKAGE_kmod-mt7921-common=n
CONFIG_PACKAGE_kmod-mt792x-common=n
CONFIG_PACKAGE_kmod-mt7915-firmware=n
CONFIG_PACKAGE_kmod-mt7916-firmware=n
CONFIG_PACKAGE_kmod-mt7921-firmware=n
CONFIG_PACKAGE_kmod-mt7922-firmware=n
CONFIG_PACKAGE_kmod-mt7925-firmware=n

# Essential base system packages
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y

# Web/RPC backend and Lua runtime (must-have for LuCI)
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_liblua=y

# ========================================
# LuCI 完整堆栈 - 一次性解决所有问题
# ========================================

# LuCI 核心组件（必须）
# 注意：为防止集合包拉起 luci-light，这里不再启用 luci 与 luci-ssl 集合包，改为逐项勾选组件
CONFIG_PACKAGE_luci=n
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-ssl=n

# 显式关闭精简版 LuCI，防止精简掉 i18n 与必要组件
CONFIG_PACKAGE_luci-light=n
# CONFIG_PACKAGE_luci-light is not set

# 进一步关闭“默认包”里的 luci-light，防止 defconfig 重新启用
CONFIG_DEFAULT_luci-light=n

# LuCI 核心库（必须 - 解决 SGI 和 JS 问题）
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-lib-httpclient=y
CONFIG_PACKAGE_luci-lib-httpprotoutils=y

# LuCI 管理模块（必须 - 提供管理界面）
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y

# LuCI 协议支持（必须 - 网络配置）
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-static=y

# LuCI 主题（必须 - 解决主题 null 问题）
# Bootstrap 作为兜底主题，Argon 作为默认主题
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-kucat=y

# 禁用其他主题避免冲突
CONFIG_PACKAGE_luci-theme-material=n
CONFIG_PACKAGE_luci-theme-openwrt=n
CONFIG_PACKAGE_luci-theme-openwrt-2020=n

# LuCI 全局中文语言支持（必须 - 控制所有 zh-cn 包）
CONFIG_LUCI_LANG_zh_Hans=y

# LuCI 中文支持（必须）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nps-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-zh-cn=y
# 网络监控中文支持
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wrtbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vnstat2-zh-cn=y
# 文件管理中文支持
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y
CONFIG_PACKAGE_luci-i18n-fileassistant-zh-cn=y
# Argon主题设置中文支持
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# NFT QoS中文支持
CONFIG_PACKAGE_luci-i18n-nft-qos-zh-cn=y
# Turbo ACC网络加速中文支持
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# LuCI 核心应用（必须）
CONFIG_PACKAGE_luci-app-firewall=y
# 包管理界面：同时保留传统 opkg 与新版 package-manager（两者不冲突）
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-package-manager=y
# 为下列 i18n 保留对应 luci-app（否则 defconfig 会剔除 i18n 包）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-nps=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-nikki=y

# 网络监控和流量统计（在线用户监控）
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-wrtbwmon=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_vnstati2=y
CONFIG_PACKAGE_wrtbwmon=y

# Netdata 实时性能监控（体积较大、常驻采集，适合 x86）
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-i18n-netdata-zh-cn=y

# 文件管理和上传功能（ipk安装）
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-fileassistant=y
# 现代文件管理器（推荐替代方案）
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y

# 网络打印服务器（RAW 打印）
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
# USB 打印机驱动（如需连接 USB 打印机）
CONFIG_PACKAGE_kmod-usb-printer=y

# Argon主题设置功能
CONFIG_PACKAGE_luci-app-argon-config=y

# NFT QoS 流量控制（单IP限速）
CONFIG_PACKAGE_luci-app-nft-qos=y

# 访问控制与应用过滤/定时断网
# - 时间段上网控制
CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-i18n-accesscontrol-zh-cn=y
# - OpenAppFilter（按应用/协议分类过滤）- 临时禁用解决编译问题
# CONFIG_PACKAGE_open-app-filter=y
# CONFIG_PACKAGE_kmod-oaf=y
# CONFIG_PACKAGE_luci-app-oaf=y
# CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
# - 定时断网
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-i18n-timecontrol-zh-cn=y

# Turbo ACC 网络加速设置
CONFIG_PACKAGE_luci-app-turboacc=n
# Turbo ACC 核心组件
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=n
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=n
CONFIG_PACKAGE_TURBOACC_INCLUDE_FULLCONENAT=n
# DNS 加速（禁用，因为使用 PassWall2/OpenClash 接管 DNS）
CONFIG_PACKAGE_TURBOACC_INCLUDE_DNSPROXY=n
CONFIG_PACKAGE_TURBOACC_INCLUDE_DNSFORWARDER=n
CONFIG_PACKAGE_TURBOACC_INCLUDE_PDNSD=n
# 显式禁用 Shortcut-FE（避免混用）
CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE=n

# ========================================
# 确保 LuCI 完整性的额外组件
# ========================================

# LuCI 模板和视图系统（解决模板缺失问题）
CONFIG_PACKAGE_luci-lib-fs=y

# 确保 JavaScript 和 CSS 资源完整（已在上方禁用，避免重复）
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set

# 强制包含所有 LuCI 依赖
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_libuci-lua=y

# 确保 uhttpd 和 LuCI 集成正确
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_uhttpd-mod-lua=y

# Essential network services
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y

# rpcd modules (stabilize LuCI RPC)
CONFIG_PACKAGE_rpcd-mod-uci=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y

# HTTPS enhancements for opkg and LuCI (TLS)
# - uclient-fetch + libustream-mbedtls + CA bundle enable HTTPS downloads
# - uhttpd-mod-tls enables LuCI over HTTPS; px5g-mbedtls auto-generates certs at first boot
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_uhttpd-mod-tls=y
CONFIG_PACKAGE_px5g-mbedtls=y

# Base services you requested
CONFIG_PACKAGE_luci-app-upnp=y
# Choose one DDNS implementation (use ddns-go as requested)
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-opkg=y

# 保持主题选择在上方“主题”段落中，避免重复配置

# Third-party GUI packages
# Ensure you add third-party feeds and/or run your Packages.sh before menuconfig/compile
CONFIG_PACKAGE_luci-app-openclash=y
# Choose ONE of passwall or passwall2 to avoid file conflicts
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-app-nikki=y

# NPS client (npc) — 客户端仅供使用/查看，不改默认配置
CONFIG_PACKAGE_npc=y

# LuCI 界面：NPS/NPC 管理（若 feeds 提供则会编译进入；若不存在会被 defconfig 移除）
CONFIG_PACKAGE_luci-app-nps=y
# 中文界面（若存在该翻译包）
CONFIG_PACKAGE_luci-i18n-nps-zh-cn=y

# PassWall2 backends: use Xray/Sing-Box only; disable Shadowsocks-libev to avoid 404 source
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_shadowsocks-libev-ss-local=n
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=n
CONFIG_PACKAGE_shadowsocks-libev-ss-server=n
CONFIG_PACKAGE_shadowsocks-libev-ss-tunnel=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=n

# LuCI explicit blacklist (prevent accidental pulls by profiles)
# Storage/NAS/Download
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-ksmbd=n
CONFIG_PACKAGE_luci-app-nfs=n
CONFIG_PACKAGE_luci-app-ftp=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_luci-app-minidlna=n
CONFIG_PACKAGE_luci-app-hd-idle=n

# Networking extras not needed (except vnstat which we enabled above for traffic monitoring)
CONFIG_PACKAGE_luci-app-mwan3=n
CONFIG_PACKAGE_luci-app-qos=n
CONFIG_PACKAGE_luci-app-pppoe-server=n

# VPN (we use Clash/PassWall family instead)
CONFIG_PACKAGE_luci-app-openvpn=n
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_luci-app-softethervpn=n
CONFIG_PACKAGE_luci-app-ipsec-vpnd=n

# Adblock/DNS suites (not requested; can enable later if needed)
CONFIG_PACKAGE_luci-app-adblock=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-app-smartdns=n

# Containers (large, not needed here)
CONFIG_PACKAGE_luci-app-docker=n
CONFIG_PACKAGE_luci-app-dockerman=n

# Misc
CONFIG_PACKAGE_luci-app-wol=n

# Resolve third-party feed dependency loops and missing deps
# Keep nft firewall (required by nikki) and preselect geoview for passwall
CONFIG_PACKAGE_geoview=y

# Explicitly disable apps that introduce recursion or missing deps in small feed
CONFIG_PACKAGE_luci-app-fchomo=n
CONFIG_PACKAGE_luci-app-alist=n
CONFIG_PACKAGE_luci-app-bypass=n
CONFIG_PACKAGE_luci-app-ssr-plus=n

# Explicitly disable SNMP packages to avoid circular dependency issues
# Use "is not set" format for cleaner configuration management
# CONFIG_PACKAGE_net-snmp is not set
# CONFIG_PACKAGE_libnetsnmp is not set
# CONFIG_PACKAGE_snmp-utils is not set
# CONFIG_PACKAGE_snmp-mibs is not set
# CONFIG_PACKAGE_luci-app-snmp is not set
# CONFIG_PACKAGE_collectd-mod-snmp is not set

# Disable specific SNMP variants that cause circular dependencies
CONFIG_PACKAGE_libnetsnmp-ssl=n
CONFIG_PACKAGE_libnetsnmp-nossl=n
CONFIG_PACKAGE_snmpd-ssl=n
CONFIG_PACKAGE_snmpd-nossl=n
CONFIG_PACKAGE_snmptrapd-ssl=n
CONFIG_PACKAGE_snmptrapd-nossl=n
CONFIG_PACKAGE_snmp-utils-ssl=n
CONFIG_PACKAGE_snmp-utils-nossl=n

# Disable packages that depend on or select SNMP variants
CONFIG_PACKAGE_php8-mod-snmp=n
CONFIG_PACKAGE_luci-app-snmpd=n
CONFIG_PACKAGE_dnsdist=n
CONFIG_PACKAGE_dnsdist-full=n
CONFIG_PACKAGE_frr=n
CONFIG_PACKAGE_lldpd=n
CONFIG_PACKAGE_asterisk-res-snmp=n
CONFIG_PACKAGE_freeswitch-mod-snmp=n
CONFIG_PACKAGE_kamailio-mod-snmpstats=n
CONFIG_PACKAGE_ifstat=n
CONFIG_PACKAGE_keepalived=n
CONFIG_PACKAGE_nut=n
CONFIG_PACKAGE_nut-common=n

# Optional multimedia stack not needed; also avoids missing deps (libmesa/wayland/graphene)
CONFIG_PACKAGE_gst1-plugins-base=n

# LuCI Chinese translations (zh-cn) for installed apps
# Base already enabled above: luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
# 在线用户监控中文支持（重复确认）
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wrtbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vnstat-zh-cn=y

# Extra guards against SNMP recursion
# libslirp was observed selecting libnetsnmp-ssl in your Kconfig dump; disable it (not needed for this router build)
CONFIG_PACKAGE_libslirp=n
# Also guard against any profile defaults trying to pull SNMP variants
CONFIG_DEFAULT_libnetsnmp-ssl=n
CONFIG_DEFAULT_libnetsnmp-nossl=n
CONFIG_DEFAULT_snmpd-ssl=n
CONFIG_DEFAULT_snmpd-nossl=n
CONFIG_DEFAULT_snmptrapd-ssl=n
CONFIG_DEFAULT_snmptrapd-nossl=n
CONFIG_DEFAULT_snmp-utils-ssl=n
CONFIG_DEFAULT_snmp-utils-nossl=n

# Force disable ALL SNMP-related symbols to break any circular dependencies
# This is a nuclear option to completely eliminate SNMP from the build
# 移除此项以避免误导；与 SNMP 无直接关系

# ========================================
# 首启脚本和静态资源配置
# ========================================
# 注意：以下文件需要手动创建在 files/ 目录中：
# - files/etc/uci-defaults/98-soften-password-nag
# - files/www/luci-static/argon/anti-password-nag.css
# - files/www/luci-static/argon/anti-password-nag.js

CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale=y
